ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
SECRET_KEY=REPLACE_ME_with_32_random_chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_ME_strong_password
DATABASE_URL=sqlite:///./cutdry.db
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_STORAGE=memory://

# Embeddings (local fastembed by default; set to "hash" for a download-free fallback)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Stripe test mode (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# For local webhook testing: stripe listen --forward-to localhost:8000/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
